+/// The account control client never becomes a subscriber, driver, approval owner,
+/// or fallback notification owner. Native admission/duplicate ACK is not a turn result.
+#[tokio::test]
+async fn mailbox_controls_preserve_owner_ui_and_never_resume_closed_sessions() {
+    use crate::leader::client::LeaderClient;
+    let temp = TempDir::new().unwrap();
+    let socket = temp.path().join("leader-mailbox.sock");
+    let mut server = spawn_leader_server(socket.clone()).await.unwrap();
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    let sid = "20000000-0000-4000-8000-000000000001";
+    let (mut actor, _, _) = server.agent_activity.register_for_test(sid);
+    let mut ui = LeaderClient::connect(
+        socket.clone(),
+        "grok-tui",
+        ClientMode::Stdio,
+        ClientCapabilities::default(),
+    )
+    .await
+    .unwrap();
+    ui.send(serde_json::json!({"jsonrpc":"2.0","id":"owner-start","method":"session/new","params":{"cwd":"/synthetic","mcpServers":[]}}).to_string()).unwrap();
+    let request: serde_json::Value =
+        serde_json::from_str(&server.acp_rx.recv().await.unwrap()).unwrap();
+    server
+        .response_tx
+        .send(
+            serde_json::json!({"jsonrpc":"2.0","id":request["id"],"result":{"sessionId":sid}})
+                .to_string(),
+        )
+        .unwrap();
+    ui.recv().await.unwrap();
+    let mut observer = LeaderClient::connect(
+        socket.clone(),
+        "babel-account-wake",
+        ClientMode::Stdio,
+        ClientCapabilities::default(),
+    )
+    .await
+    .unwrap();
+    let sessions = observer
+        .send_control(ControlCommand::MailboxSessions)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        matches!(sessions, ControlPayload::MailboxSessions { sessions } if sessions.len() == 1 && sessions[0].id == sid)
+    );
+    let nid = "a".repeat(64);
+    let text = "Babel mailbox notification for synthetic participant";
+    let actor_task = tokio::spawn(async move {
+        match actor.recv().await.unwrap() {
+            crate::session::SessionCommand::MailboxNotification {
+                notification_id,
+                text: received,
+                respond_to,
+            } => {
+                assert_eq!(notification_id, "a".repeat(64));
+                assert_eq!(received, text);
+                respond_to.send(true).unwrap();
+            }
+            _ => panic!("notification-only command required"),
+        }
+        actor
+    });
+    let command = || ControlCommand::QueueMailboxNotification {
+        session_id: sid.to_string(),
+        notification_id: nid.clone(),
+        text: text.to_string(),
+    };
+    let accepted = observer.send_control(command()).await.unwrap().unwrap();
+    assert!(
+        matches!(accepted, ControlPayload::MailboxNotification { state, .. } if state == "queued")
+    );
+    let mut actor = actor_task.await.unwrap();
+    let duplicate = observer.send_control(command()).await.unwrap().unwrap();
+    assert!(
+        matches!(duplicate, ControlPayload::MailboxNotification { state, .. } if state == "duplicate")
+    );
+    assert!(actor.try_recv().is_err());
+    let approval = serde_json::json!({"jsonrpc":"2.0","id":"owner-permission","method":"session/request_permission","params":{"sessionId":sid}}).to_string();
+    server.response_tx.send(approval.clone()).unwrap();
+    let delivered = tokio::time::timeout(Duration::from_secs(2), ui.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        serde_json::from_str::<serde_json::Value>(&delivered).unwrap(),
+        serde_json::from_str::<serde_json::Value>(&approval).unwrap()
+    );
+    assert!(
+        tokio::time::timeout(Duration::from_millis(50), observer.recv())
+            .await
+            .is_err()
+    );
+    observer.cancel();
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    // Unlike an ACP observer, a control disconnect preserves the last UI owner.
+    server
+        .response_tx
+        .send(r#"{"jsonrpc":"2.0","method":"native-fallback","params":{}}"#.to_string())
+        .unwrap();
+    let fallback = tokio::time::timeout(Duration::from_secs(2), ui.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        serde_json::from_str::<serde_json::Value>(&fallback).unwrap()["method"],
+        "native-fallback"
+    );
+    let observer = LeaderClient::connect(
