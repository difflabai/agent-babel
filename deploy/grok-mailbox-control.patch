+/// Mailbox traffic stays native synthetic activity and cannot reopen a user hold.
+#[tokio::test(flavor = "current_thread")]
+async fn mailbox_notification_keeps_cancel_block_and_native_activity_semantics() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            let (gateway_tx, _gateway_rx) = mpsc::unbounded_channel();
+            let (persistence_tx, persistence_rx) = mpsc::unbounded_channel();
+            let _annotations = spawn_persistence_drain(persistence_rx);
+            let actor = create_test_actor(0, 256_000, 85, gateway_tx, persistence_tx).await;
+            let nid = "a".repeat(64);
+            actor.state.lock().await.notifications_suppressed = true;
+            assert!(
+                !actor
+                    .admit_mailbox_notification(
+                        nid.clone(),
+                        "Babel mailbox notification for synthetic".into()
+                    )
+                    .await
+            );
+            assert!(actor.state.lock().await.pending_inputs.is_empty());
+            assert!(actor.state.lock().await.notifications_suppressed);
+            actor.state.lock().await.notifications_suppressed = false;
+            let generation = actor
+                .user_input_generation
+                .load(std::sync::atomic::Ordering::Acquire);
+            assert!(
+                actor
+                    .admit_mailbox_notification(
+                        nid.clone(),
+                        "Babel mailbox notification for synthetic".into()
+                    )
+                    .await
+            );
+            let state = actor.state.lock().await;
+            assert_eq!(state.pending_inputs.len(), 1);
+            let queued = state.pending_inputs.front().unwrap();
+            assert!(queued.input_origin.is_synthetic());
+            assert!(!queued.send_now);
+            assert_eq!(queued.prompt_id, format!("notifications-babel-{nid}"));
+            assert_eq!(
+                actor
+                    .user_input_generation
+                    .load(std::sync::atomic::Ordering::Acquire),
+                generation
+            );
+        })
+        .await;
+}
